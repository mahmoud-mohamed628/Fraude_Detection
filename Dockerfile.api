FROM python:3.11-slim

WORKDIR /app

# Installation des dépendances (avec pandas et mlflow)
RUN pip install --no-cache-dir fastapi pydantic uvicorn pandas mlflow

# Copie du code source
COPY src/ /app/src/

EXPOSE 8000

# Commande de lancement de l'API
CMD ["uvicorn", "src.fraud.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]